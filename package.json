{
  "name": "bindaas",
  "version": "0.2.1",
  "description": "A calm desktop workbench for Codex and Claude Code (unofficial, macOS).",
  "license": "MIT",
  "author": "The Bindaas contributors",
  "repository": {
    "type": "git",
    "url": "https://github.com/solo-novato/bindaas.git"
  },
  "homepage": "https://github.com/solo-novato/bindaas",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "vite build",
    "check": "svelte-check --tsconfig ./tsconfig.json",
    "test": "vitest run",
    "test:ui": "playwright test",
    "format": "prettier --write src tests *.json *.ts *.js *.html *.md && cargo fmt --manifest-path src-tauri/Cargo.toml",
    "lint": "prettier --check src tests *.json *.ts *.js *.html *.md",
    "tauri": "tauri",
    "desktop": "tauri dev",
    "schema": "codex app-server generate-ts --experimental --out schemas/codex",
    "dist:mac": "tauri build --target aarch64-apple-darwin --bundles app,dmg",
    "notices": "node scripts/third-party-notices.mjs",
    "screenshots": "SCREENSHOTS=1 playwright test tests/ui/screenshots.spec.ts",
    "styles:snapshot": "STYLE_SNAPSHOT=test-results/style-snapshot.json playwright test tests/ui/style-snapshot.spec.ts"
  },
  "dependencies": {
    "@codemirror/autocomplete": "^6.18.0",
    "@codemirror/commands": "^6.8.0",
    "@codemirror/lang-css": "^6.3.0",
    "@codemirror/lang-html": "^6.4.0",
    "@codemirror/lang-java": "^6.0.0",
    "@codemirror/lang-javascript": "^6.2.0",
    "@codemirror/lang-json": "^6.0.0",
    "@codemirror/lang-markdown": "^6.3.0",
    "@codemirror/lang-python": "^6.2.0",
    "@codemirror/lang-rust": "^6.0.0",
    "@codemirror/lang-sql": "^6.9.0",
    "@codemirror/lang-xml": "^6.1.0",
    "@codemirror/lang-yaml": "^6.1.0",
    "@codemirror/language": "^6.11.0",
    "@codemirror/search": "^6.5.0",
    "@codemirror/state": "^6.5.0",
    "@codemirror/view": "^6.38.0",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@tauri-apps/api": "^2.8.0",
    "markdown-it": "^14.1.0",
    "svelte": "^5.38.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.55.0",
    "@sveltejs/vite-plugin-svelte": "^6.1.0",
    "@tauri-apps/cli": "^2.8.0",
    "@types/markdown-it": "^14.1.0",
    "@types/node": "^24.0.0",
    "prettier": "^3.6.0",
    "prettier-plugin-svelte": "^3.4.0",
    "svelte-check": "^4.3.0",
    "typescript": "^5.9.0",
    "vite": "^7.1.0",
    "vitest": "^4.1.11"
  }
}
